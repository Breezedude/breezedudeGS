# Heltec WiFi LoRa 32 V3 and other ESP32-S3 + SX1262 boards (primary target).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 160 MHz ceiling instead of 240: LoRa and WiFi are comfortable there and DFS
# scales down to the 40 MHz XTAL between packets.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP32S3_DATA_CACHE_64KB=y
